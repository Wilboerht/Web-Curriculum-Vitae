---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import ProjectSection from "../components/ProjectSection.astro";
import { PROJECT_DATA } from "../data/projects";
import "../styles/global.css";
import "../styles/cv.css";

const projectData = PROJECT_DATA["zh-CN"];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-cn/#page",
  "url": "https://cv.wilboerht.com/CV-cn/",
  "inLanguage": "zh-CN",
  "name": "王泓坤 - 简历",
  "description": "王泓坤的个人简历页面：常驻上海的数字开发经理、全栈工程师。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "数字开发经理、全栈工程师（TypeScript / React / Next.js / AI / RAG），常驻上海。作为 Moidas（NIHPLOD）大中华区首位工程师，从零搭建品牌官网、会员体系与积分、统一认证（SSO）、AI 护肤顾问、企微 AI 客服、授权验真与双小程序等数字系统。",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科学技术职业学院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "SEO",
      "GEO (Generative Engine Optimization)",
      "AEO (Answer Engine Optimization)",
      "Docker",
      "Linux"
    ],
    "jobTitle": "数字开发经理",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "穆埃达思 Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖（全市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“职业技能等级证书”计算机程序设计员 三级（高级工）（竞赛）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "国家信息安全水平考试二级（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级开发工程师认证（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里云 ACA 云安全助理工程师认证",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级运维工程师认证",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖"
  }
};
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">数字开发经理 · 全栈工程师 · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>个人简介</h2>
      <p class="entry-desc">
        我目前在 Moidas 工作，负责 NIHPLOD 大中华区事业部品牌数字化产品的规划、技术选型与全栈交付。欢迎通过 <a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a> 与我进行任何交流。
      </p>
    </section>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">穆埃达思 Moidas · 旎柏（大中华区）事业部</h3>
          <div class="entry-meta">
            <span class="entry-role">数字开发经理</span>
            <span class="entry-date">2025.10 – 至今</span>
          </div>
        </div>
        <p class="entry-summary">
          2025.10 以全职实习生加入，2026.07 转正为数字开发经理并直接汇报品牌负责人；作为事业部首位工程师，以产品思维和 AI 辅助研发独立完成从需求、设计到开发、上线的全栈交付。入职 12 个月内从零搭建并上线 7 个核心系统（其中 2 个小程序持续迭代），配套 2,900+ 自动化测试用例，并以统一账号与档案数据形成「测肤 → 个性化方案 → 7×24 AI 顾问跟进 → 复购」业务闭环。
        </p>
        <ul class="project-points">
          <li>负责品牌大中华区数字化产品矩阵的规划、技术选型与全栈交付，统筹 7 个核心系统从需求、设计、开发到上线运维的完整生命周期。</li>
          <li>参与品牌大中华区会员体系制定，联合品牌与运营团队设计四档会员等级、权益、积分与兑礼规则，并上线官网与小程序会员中心，支撑会员留存与复购。</li>
          <li>建立 AI 辅助研发工作流与设计规范，将平均交付周期缩短约 50%，支撑多项目并行交付。</li>
          <li>作为技术侧负责人对接产品、营销团队需求并拆解排期，主导需求评审与迭代节奏，支撑品牌线上零售渠道（中国官网）从零上线。</li>
          <li>建立品牌官网与 AI 测肤站的搜索与 AI 可发现性体系（SEO / GEO / AEO）：动态 sitemap、AI 爬虫策略、Organization / Product / FAQ / HowTo JSON-LD、llms.txt / llms-full.txt、可后台维护的产品级 GEO FAQ，以及百度 / IndexNow 主动推送。</li>
          <li>主导 ICP 备案、隐私政策及用户协议起草，完成数据合规审查，保障多系统合规上线。</li>
          <li>依据流量动态调整服务器资源配置，优化服务器成本。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.cn}
          alt="穆埃达思 Moidas 大中华区数字化系统架构图：统一认证（SSO）连接官网、AI 测肤、AI 客服与授权验真等核心系统"
          zoomLabel="查看大图"
          closeLabel="关闭"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海临港景鸿安全防范科技发展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">技术研发实习生</span>
            <span class="entry-date">2025.07 – 2025.09</span>
          </div>
        </div>
        <ul class="project-points">
          <li>独立承担企业官网全链路交付，覆盖从架构设计、UI/UX 设计到生产部署全过程。</li>
          <li>基于宇树机器狗 SDK 二次开发，完成园区巡逻管理控制平台内部初版并验证产品可行性。</li>
          <li>推动 AI 问答助手在企业内部首次上线，并参与公司与百度企业问答团队的商务对接。</li>
        </ul>
      </div>
    </section>

    <ProjectSection locale="zh-CN" projects={projectData.projects} ui={projectData.ui} />

    <section>
      <h2>技术栈</h2>
      <div class="skills-row">
        <span class="skills-label">前端 &amp; 小程序：</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · 微信小程序 · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">后端 &amp; 数据：</span>
        <span class="skills-content">Node.js · Python (FastAPI) · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI 工程：</span>
        <span class="skills-content">大模型集成 · 视觉测肤 · RAG · 提示词 / 知识库 · AI 成本工程（熔断 / 预算上限） · 模型评估与回归测试 · AI 辅助研发（Claude Code / Codex）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">搜索与 AI 可发现性：</span>
        <span class="skills-content">SEO · GEO · AEO · JSON-LD 结构化数据 · 动态 sitemap · AI 爬虫策略 · llms.txt / llms-full.txt · 百度推送 / IndexNow</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">工程化 &amp; 平台：</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · 自动化测试（单元 / 集成 / 回归）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合规：</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS（行级安全） · ICP 备案 · 隐私与数据合规（PIPL）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">产品 &amp; UI/UX：</span>
        <span class="skills-content">产品设计（PRD） · UI/UX 设计 · 交互设计 · 设计评审 · 设计到代码（design-to-code）</span>
      </div>
    </section>

    <section>
      <h2>获奖及证书</h2>
      <div class="award-row">
        <span class="award-name">上海市“星光计划”职业院校技能竞赛 · 网站技术 三等奖（全市第 16 名）</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">人社部职业技能等级证书 · 计算机程序设计员（三级/高级工，竞赛）</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">国家信息安全水平考试（NISP）二级</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">天翼云高级运维工程师认证</span>
        <span class="award-date">2024.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">阿里云 ACA 云安全助理工程师</span>
        <span class="award-date">2024.10</span>
      </div>
      <div class="award-row">
        <span class="award-name">天翼云高级开发工程师认证（SCCP）</span>
        <span class="award-date">2024.11</span>
      </div>
    </section>

    <section>
      <h2>教育背景</h2>
      <div class="entry education-entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <h3 class="entry-org">上海科学技术职业学院</h3>
          </div>
          <span class="entry-date">2023.10 – 2026.06</span>
        </div>
        <div class="entry-major">
          通信与电子工程学院，信息安全技术应用专业，专科
        </div>
        <p class="entry-desc">
          <strong>学业成绩：</strong>GPA 3.41/4.00
        </p>
        <p class="entry-desc">
          <strong>校内获奖：</strong>2023–2025 连续两学年校二等奖学金，2023–2024 学年校优秀学生，校优秀毕业生
        </p>
        <p class="entry-desc">
          <strong>主修课程：</strong>网络安全、程序设计、算法与数据结构、计算机体系结构、操作系统、数据库系统、计算机网络等
        </p>
      </div>
    </section>

    <section>
      <h2>语言能力</h2>
      <div class="skills-row">
        <span class="skills-label">中文：</span>
        <span class="skills-content">母语</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">英语：</span>
        <span class="skills-content">大学英语四级（CET-4）</span>
      </div>
    </section>

    <section>
      <h2>其他</h2>
      <div class="award-row">
        <span class="award-name">Google Developer Group（GDG）社区成员</span>
      </div>
      <div class="award-row">
        <span class="award-name">中国电子学会青少年等级考试测评教师（Python）</span>
      </div>
    </section>
  </div>

  <PrintFooter
    warning="本简历含个人隐私信息，仅限招聘评估使用，未经授权禁止存储、转发或用于其他用途。"
  />
</Layout>
