---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import ProjectSection from "../components/ProjectSection.astro";
import { PROJECT_DATA } from "../data/projects";
import "../styles/global.css";
import "../styles/cv.css";

const projectData = PROJECT_DATA["de"];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-de/#page",
  "url": "https://cv.wilboerht.com/CV-de/",
  "inLanguage": "de",
  "name": "Hongkun Wang - Lebenslauf",
  "description": "Profilseite von Hongkun Wang, Digital Development Manager und Full-Stack-Entwickler in Shanghai.",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "Digital Development Manager und Full-Stack-Entwickler (TypeScript / React / Next.js / AI / RAG) mit Sitz in Shanghai. Erster Ingenieur der Greater-China-Sparte von Moidas (NIHPLOD) — Aufbau der Markenwebsite, des Mitglieder- und Punktesystems, der einheitlichen Authentifizierung, des KI-Hautpflegeberaters, des WeCom-KI-Kundenservice, der Autorisierungsprüfung und zweier Mini-Programme von Grund auf.",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Shanghai",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Shanghai Scientific and Technical Vocational College"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "SEO",
      "GEO (Generative Engine Optimization)",
      "AEO (Answer Engine Optimization)",
      "Docker",
      "Linux"
    ],
    "jobTitle": "Digital Development Manager",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '3. Preis in „Webtechnologie“ beim Berufswettbewerb „Starlight Plan“ in Shanghai (Platz 16 in Shanghai)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "MOHRSS-Zertifikat für berufliche Qualifikationsstufen: Computerprogrammierer Stufe III (Fortgeschritten) (Wettbewerb)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "National Information Security Test Program Stufe II (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced-Developer-Zertifizierung (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACA Cloud Security Associate-Zertifizierung",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced-O&M-Engineer-Zertifizierung",
        "dateCreated": "2024-05"
      }
    ],
    "award": "3. Preis in „Webtechnologie“ beim Berufswettbewerb „Starlight Plan“ in Shanghai"
  }
};
---

<Layout
  title="Hongkun Wang - Lebenslauf"
  lang="de"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>Hongkun Wang</h1>
      <p class="tagline">Digital Development Manager · Full-Stack-Entwickler · Shanghai</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>Profil</h2>
      <p class="entry-desc">
        Digital Development Manager und Full-Stack-Entwickler mit Sitz in
        Shanghai, spezialisiert auf TypeScript / React / Next.js sowie KI- und
        RAG-Engineering. Als erster Ingenieur der Greater-China-Sparte von
        Moidas (NIHPLOD) 7 Kernsysteme von Grund auf aufgebaut — Markenwebsite
        &amp; Mitgliederplattform, einheitliches SSO, KI-Hautpflegeberater,
        WeCom-KI-Kundenservice, Autorisierungsprüfung,
        KI-Hautanalyse-Mini-Programm und Mitgliedercenter-Mini-Programm —
        abgesichert durch 2.900+ automatisierte Testfälle. Stärke in der
        eigenverantwortlichen End-to-End-Umsetzung von der Anforderung über das
        Design bis zu Launch und Betrieb mit Produktdenken.
      </p>
    </section>

    <section>
      <h2>Berufserfahrung</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD Greater China Division</h3>
          <div class="entry-meta">
            <span class="entry-role">Digital Development Manager</span>
            <span class="entry-date">Okt. 2025 – heute</span>
          </div>
        </div>
        <p class="entry-summary">
          Im Oktober 2025 als Vollzeitpraktikant während des Studiums eingestiegen, im Juli 2026 in eine Festanstellung übernommen, mit direkter Berichtslinie an die Markenleitung. Als erster Ingenieur der Sparte die Full-Stack-Umsetzung von der Anforderung über das Design bis zur Entwicklung und zum Launch mit Produktdenken und KI-gestützter Entwicklung eigenständig verantwortet; in den ersten 12 Monaten 7 Kernsysteme von Grund auf aufgebaut und gestartet (2 Mini-Programme werden weiterentwickelt), abgesichert durch 2.900+ automatisierte Testfälle, und über einheitliche Konten und Profildaten den Kreislauf „Hautanalyse → personalisierte Pflegeroutine → 7×24-KI-Beratung → Wiederkauf“ geschlossen.
        </p>
        <ul class="project-points">
          <li>Planung, Technologieauswahl und Full-Stack-Lieferung des digitalen Produktportfolios der Marke für Greater China verantwortet; den vollständigen Lebenszyklus von 7 Kernsystemen von Anforderungen und Design über Entwicklung und Launch bis zum Betrieb gesteuert.</li>
          <li>Das Mitgliedersystem für Greater China gemeinsam mit Marken- und Operationsteams mitgestaltet — vier Mitgliedsstufen, Vorteile, Punkte- und Einlöseregeln — und auf der offiziellen Website sowie im Mitgliedercenter-Mini-Programm umgesetzt, um Bindung und Wiederkauf zu fördern.</li>
          <li>KI-gestützte Entwicklungsworkflows und Designstandards etabliert und die durchschnittlichen Entwicklungszyklen um rund 50 % verkürzt — bei paralleler Umsetzung mehrerer Projekte.</li>
          <li>Als technischer Lead Anforderungen von Produkt- und Marketingteams aufgenommen und in Lieferpläne übersetzt, Anforderungs-Reviews und Iterationsrhythmus verantwortet sowie den Online-Handelskanal der Marke (offizielle China-Website) von der Konzeption bis zum Launch begleitet.</li>
          <li>Die Such- und KI-Auffindbarkeitsinfrastruktur für die Markenwebsite und die KI-Hautanalyse-Site aufgebaut (SEO / GEO / AEO): dynamische Sitemap, KI-Crawler-Strategie, Organization-/Product-/FAQ-/HowTo-JSON-LD, llms.txt / llms-full.txt, im Admin-Bereich pflegbare produktspezifische GEO-FAQs sowie Baidu- und IndexNow-Push.</li>
          <li>ICP-Anmeldung, Datenschutzrichtlinie und Nutzungsvereinbarung verantwortet sowie Datenschutz-Compliance-Reviews durchgeführt, um Compliance-konforme Launches über alle Systeme sicherzustellen.</li>
          <li>Serverressourcen dynamisch an das Zugriffsvolumen angepasst, um die Infrastrukturkosten zu optimieren.</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.de}
          alt="Architekturübersicht der digitalen Systeme von Moidas Greater China: einheitliches SSO verbindet offizielle Website, KI-Hautanalyse, KI-Kundenservice und Autorisierungsverifizierung"
          zoomLabel="Vergrößern"
          closeLabel="Schließen"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Shanghai Lingang Jinghong Security Technology Development Co., Ltd.</h3>
          <div class="entry-meta">
            <span class="entry-role">F&amp;E-Praktikant</span>
            <span class="entry-date">Jul. 2025 – Sep. 2025</span>
          </div>
        </div>
        <ul class="project-points">
          <li>Eigenverantwortliche End-to-End-Umsetzung der Unternehmenswebsite — von Architektur und UI/UX-Design bis zum Produktions-Deployment.</li>
          <li>Auf Basis des Unitree-Roboterhund-SDKs ein internes MVP für eine Campus-Patrouillen-Verwaltungsplattform entwickelt und die Produktmachbarkeit validiert.</li>
          <li>Die erste interne Einführung von KI-Frage-Antwort-Tools im Unternehmen vorangetrieben und die geschäftliche Abstimmung des Unternehmens mit Baidus offiziellem Enterprise-QA-Team mitgestaltet.</li>
        </ul>
      </div>
    </section>

    <ProjectSection locale="de" projects={projectData.projects} ui={projectData.ui} />

    <section>
      <h2>Tech-Stack</h2>
      <div class="skills-row">
        <span class="skills-label">Frontend &amp; Mini-Programme:</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · WeChat-Mini-Programm · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Backend &amp; Daten:</span>
        <span class="skills-content">Node.js · Python (FastAPI) · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">KI-Engineering:</span>
        <span class="skills-content">LLM-Integration · visuelle Hautanalyse · RAG · Prompt / Wissensbasis · KI-Kosten-Engineering (Circuit Breaker / Budgetobergrenzen) · Modell-Evaluation &amp; Regressionstests · KI-gestützte Entwicklung (Claude Code / Codex)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Suche &amp; KI-Auffindbarkeit:</span>
        <span class="skills-content">SEO · GEO · AEO · JSON-LD-Strukturdaten · dynamische Sitemap · KI-Crawler-Strategie · llms.txt / llms-full.txt · Baidu-Push / IndexNow</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Engineering &amp; Plattform:</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · automatisierte Tests (Unit / Integration / Regression)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Sicherheit &amp; Compliance:</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS (Row-Level Security) · ICP-Registrierung · Datenschutz &amp; Datencompliance (PIPL)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Produkt &amp; UI/UX:</span>
        <span class="skills-content">Produktdesign (PRD) · UI/UX-Design · Interaktionsdesign · Design-Review · Design-to-Code</span>
      </div>
    </section>

    <section>
      <h2>Auszeichnungen &amp; Zertifikate</h2>
      <div class="award-row">
        <span class="award-name">3. Preis in „Webtechnologie“ beim „Starlight Plan“-Berufswettbewerb in Shanghai (Platz 16 in Shanghai)</span>
        <span class="award-date">Mai 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name">MOHRSS-Berufsqualifikationszertifikat · Computerprogrammierer (Stufe III/Facharbeiter, Wettbewerb)</span>
        <span class="award-date">Mai 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name">National Information Security Test Program (NISP) Stufe II</span>
        <span class="award-date">Mai 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name">CTyun Advanced O&amp;M Engineer</span>
        <span class="award-date">Mai 2024</span>
      </div>
      <div class="award-row">
        <span class="award-name">Alibaba Cloud ACA Cloud Security Associate</span>
        <span class="award-date">Okt. 2024</span>
      </div>
      <div class="award-row">
        <span class="award-name">CTyun Advanced Developer Certification (SCCP)</span>
        <span class="award-date">Nov. 2024</span>
      </div>
    </section>

    <section>
      <h2>Ausbildung</h2>
      <div class="entry education-entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <h3 class="entry-org"
              >Shanghai Scientific and Technical Vocational College</h3>
          </div>
          <span class="entry-date">Okt. 2023 – Jun. 2026</span>
        </div>
        <div class="entry-major">
          Fakultät für Kommunikations- &amp; Elektrotechnik, Angewandte
          Informationssicherheitstechnik, Associate Degree
        </div>
        <p class="entry-desc">
          <strong>Akademische Leistung:</strong> GPA 3.41/4.00
        </p>
        <p class="entry-desc">
          <strong>Auszeichnungen der Hochschule:</strong> Stipendium der 2. Klasse in zwei aufeinanderfolgenden Studienjahren (2023–2025), Auszeichnung als herausragender Studierender (2023–2024), herausragender Absolvent
        </p>
        <p class="entry-desc">
          <strong>Kernfächer:</strong> Netzwerksicherheit, Programmierung, Algorithmen &amp; Datenstrukturen,
          Rechnerarchitektur, Betriebssysteme, Datenbanksysteme, Computernetzwerke u. a.
        </p>
      </div>
    </section>

    <section>
      <h2>Sprachen</h2>
      <div class="skills-row">
        <span class="skills-label">Chinesisch:</span>
        <span class="skills-content">Muttersprache</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Englisch:</span>
        <span class="skills-content">College English Test Band 4 (CET-4)</span>
      </div>
    </section>

    <section>
      <h2>Sonstiges</h2>
      <div class="award-row">
        <span class="award-name">Mitglied der Google Developer Group (GDG)</span>
      </div>
      <div class="award-row">
        <span class="award-name">Bewertungslehrer, Jugendstufenprüfung der Chinese Institute of Electronics (Python)</span>
      </div>
    </section>
  </div>

  <PrintFooter
    warning="Dieser Lebenslauf enthält persönliche Daten und ist ausschließlich für die Bewertung im Rahmen von Einstellungsverfahren bestimmt. Unbefugte Speicherung, Weitergabe oder sonstige Nutzung ist untersagt."
  />
</Layout>
