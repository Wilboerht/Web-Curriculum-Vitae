---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import ProjectSection from "../components/ProjectSection.astro";
import { PROJECT_DATA } from "../data/projects";
import "../styles/global.css";
import "../styles/cv.css";

const projectData = PROJECT_DATA["ja"];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-jp/#page",
  "url": "https://cv.wilboerht.com/CV-jp/",
  "inLanguage": "ja",
  "name": "王泓坤 - 履歴書",
  "description": "上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア、王泓坤のプロフィールページ。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア（TypeScript / React / Next.js / AI / RAG）。Moidas（NIHPLOD）大中華圏事業部初のエンジニアとして、ブランド公式サイト、会員・ポイント制度、統合認証、AIスキンケアアドバイザー、WeCom AIカスタマーサービス、認証検証プラットフォーム、ミニプログラム2種をゼロから構築。",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科学技術職業学院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "デジタル開発マネージャー",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市「星光計画」職業技能競技大会「Web技術」部門3等賞（上海市16位）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人力資源社会保障部 職業技能等級証書：コンピュータープログラマー3級（上級）（競技）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "国家情報セキュリティレベル試験2級（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun上級開発者認定（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACAクラウドセキュリティアソシエイト認定",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun上級運用保守エンジニア認定",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市「星光計画」職業技能競技大会「Web技術」部門3等賞"
  }
};
---

<Layout title="王泓坤 - 履歴書" lang="ja">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">デジタル開発マネージャー · フルスタックエンジニア · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>プロフィール</h2>
      <p class="entry-desc">
        上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア。TypeScript / React / Next.js と AI / RAG エンジニアリングを専門としています。Moidas（NIHPLOD）大中華圏事業部初のエンジニアとして、ブランド公式サイト・会員プラットフォーム、統合SSO、AIスキンケアアドバイザー、WeCom AIカスタマーサービス、認証検証プラットフォーム、AI肌診断ミニプログラム、会員センターミニプログラムの計7つの基幹システムをゼロから構築し、2,900件以上の自動テストで支えています。プロダクト思考で要件定義・設計からリリース・運用までのEnd-to-End遂行を得意としています。
      </p>
    </section>

    <section>
      <h2>職務経歴</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD 大中華圏事業部</h3>
          <div class="entry-meta">
            <span class="entry-role">デジタル開発マネージャー</span>
            <span class="entry-date">2025年10月 – 現在</span>
          </div>
        </div>
        <p class="entry-summary">
          2025年10月に在学中ながらフルタイムインターンとして入社し、2026年7月に正社員へ登用。ブランド責任者に直接報告。事業部初のエンジニアとして、プロダクト思考とAIを活用した開発ワークフローで、要件定義・設計から開発・リリースまでのフルスタック開発を独力で担当。入社後12か月で7つの基幹システムをゼロから構築・リリースし（ミニプログラム2種は継続改善中）、2,900件以上の自動テストで支えながら、統一アカウントとプロフィールデータを通じて「肌診断 → パーソナライズされたスキンケア提案 → 7×24 AIアドバイザーによるフォローアップ → リピート購入」の購買サイクルを実現。
        </p>
        <ul class="project-points">
          <li>大中華圏におけるブランドのデジタルプロダクト群について、企画・技術選定・フルスタック開発を統括。7つの基幹システムの要件定義、設計、開発、リリース、運用まで全ライフサイクルを担当。</li>
          <li>ブランド・運営チームと協力し、4段階の会員ランク、特典、ポイント、交換ルールを含む大中華圏向け会員制度の策定に貢献。公式サイトとミニプログラムの会員センターに実装し、会員定着とリピート購入を支援。</li>
          <li>AIを活用した開発ワークフローとデザイン標準を確立し、平均開発期間を約50%短縮すると同時に、複数プロジェクトの並行開発を支援。</li>
          <li>技術リードとして、プロダクト・マーケティングチームからの要件を集約して納期計画に落とし込み、要件レビューとイテレーションの進行を管理。ブランドのオンライン直販チャネル（中国公式サイト）の立ち上げを支援。</li>
          <li>ICP届出、プライバシーポリシー・利用規約の起草、データコンプライアンス審査を主導し、各システムのコンプライアンスを確保。</li>
          <li>トラフィックに応じてサーバーリソースを動的に調整し、インフラコストを最適化。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.ja}
          alt="Moidas大中華圏デジタルシステムの構成図：統一SSOが公式サイト、AI肌診断、AIカスタマーサービス、認証確認を接続"
          zoomLabel="拡大表示"
          closeLabel="閉じる"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海臨港景鴻安全防範科技発展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">研究開発インターン</span>
            <span class="entry-date">2025年7月 – 2025年9月</span>
          </div>
        </div>
        <ul class="project-points">
          <li>アーキテクチャ設計、UI/UXデザインから本番環境へのデプロイまで、企業公式サイトの全工程を独力で担当。</li>
          <li>Unitreeロボット犬SDKの二次開発により、構内巡回管理プラットフォームの社内MVPを完成させ、製品の実現可能性を検証。</li>
          <li>AI Q&amp;Aツールの社内初導入を推進し、百度公式の企業向けQ&amp;Aチームとの業務連携に参画。</li>
        </ul>
      </div>
    </section>

    <ProjectSection locale="ja" projects={projectData.projects} ui={projectData.ui} />

    <section>
      <h2>技術スタック</h2>
      <div class="skills-row">
        <span class="skills-label">フロントエンド・ミニプログラム：</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · WeChatミニプログラム · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">バックエンド・データ：</span>
        <span class="skills-content">Node.js · Python（FastAPI） · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AIエンジニアリング：</span>
        <span class="skills-content">LLM連携 · 画像による肌診断 · RAG · プロンプト / ナレッジベース · AIコスト制御（サーキットブレーカー / 予算上限） · モデル評価・リグレッションテスト · AI支援開発（Claude Code / Codex）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">開発基盤・プラットフォーム：</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · 自動テスト（単体 / 結合 / リグレッション）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">セキュリティ・コンプライアンス：</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS（行レベルセキュリティ） · ICP届出 · プライバシー・データコンプライアンス（PIPL）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">プロダクト &amp; UI/UX：</span>
        <span class="skills-content">プロダクトデザイン（PRD） · UI/UXデザイン · インタラクション設計 · デザインレビュー · デザインからコードへの実装（design-to-code）</span>
      </div>
    </section>

    <section>
      <h2>受賞・資格</h2>
      <div class="award-row">
        <span class="award-name">上海市「星光計画」職業技能競技大会「Web技術」部門3等賞（上海市16位）</span>
        <span class="award-date">2025年5月</span>
      </div>
      <div class="award-row">
        <span class="award-name">人力資源社会保障部 職業技能等級証書・コンピュータープログラマー（3級 / 上級技能士、競技）</span>
        <span class="award-date">2025年5月</span>
      </div>
      <div class="award-row">
        <span class="award-name">国家情報セキュリティレベル試験（NISP）2級</span>
        <span class="award-date">2025年5月</span>
      </div>
      <div class="award-row">
        <span class="award-name">CTyun上級運用保守エンジニア</span>
        <span class="award-date">2024年5月</span>
      </div>
      <div class="award-row">
        <span class="award-name">Alibaba Cloud ACAクラウドセキュリティアソシエイト</span>
        <span class="award-date">2024年10月</span>
      </div>
      <div class="award-row">
        <span class="award-name">CTyun上級開発者認定（SCCP）</span>
        <span class="award-date">2024年11月</span>
      </div>
    </section>

    <section>
      <h2>学歴</h2>
      <div class="entry education-entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <h3 class="entry-org">上海科学技術職業学院</h3>
          </div>
          <span class="entry-date">2023年10月 – 2026年6月</span>
        </div>
        <div class="entry-major">
          通信・電子工程学院 情報セキュリティ技術応用専攻 専科（短期大学相当）
        </div>
        <p class="entry-desc">
          <strong>学業成績：</strong>GPA 3.41/4.00
        </p>
        <p class="entry-desc">
          <strong>校内受賞：</strong>2023–2025年度の2学年連続で二等奨学金、2023–2024年度優秀学生、優秀卒業生
        </p>
        <p class="entry-desc">
          <strong>主な履修科目：</strong>ネットワークセキュリティ、プログラミング、アルゴリズム・データ構造、コンピュータアーキテクチャ、オペレーティングシステム、データベースシステム、コンピュータネットワークなど
        </p>
      </div>
    </section>

    <section>
      <h2>言語</h2>
      <div class="skills-row">
        <span class="skills-label">中国語：</span>
        <span class="skills-content">ネイティブ</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">英語：</span>
        <span class="skills-content">大学英語4級（CET-4）</span>
      </div>
    </section>

    <section>
      <h2>その他</h2>
      <div class="award-row">
        <span class="award-name">Google Developer Group（GDG）コミュニティメンバー</span>
      </div>
      <div class="award-row">
        <span class="award-name">中国電子学会 青少年等級試験 評価教師（Python）</span>
      </div>
    </section>
  </div>

  <PrintFooter
    warning="本履歴書には個人情報が含まれており、採用選考の評価のみを目的としています。無断での保存、転送、その他の利用を禁じます。"
  />
</Layout>
