---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import ProjectSection from "../components/ProjectSection.astro";
import { PROJECT_DATA } from "../data/projects";
import "../styles/global.css";
import "../styles/cv.css";

const projectData = PROJECT_DATA["ko"];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-kr/#page",
  "url": "https://cv.wilboerht.com/CV-kr/",
  "inLanguage": "ko",
  "name": "Hongkun Wang - 이력서",
  "description": "상하이에 거주하는 디지털 개발 매니저이자 풀스택 엔지니어 Hongkun Wang의 이력서 페이지입니다.",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "상하이에 거주하는 디지털 개발 매니저이자 풀스택 엔지니어(TypeScript / React / Next.js / AI / RAG). Moidas(NIHPLOD) 중화권 사업부의 첫 엔지니어로 브랜드 공식 사이트, 멤버십·포인트 체계, 통합 인증(SSO), AI 스킨케어 어드바이저, 위챗워크(WeCom) AI 고객서비스, 인증 검증 플랫폼, 미니프로그램 2종을 처음부터 구축.",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "상하이",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "상하이과학기술직업학원"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "디지털 개발 매니저",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "모이다스",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등 (시 전체 16위)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "인력자원사회보장부 직업기능등급증서: 컴퓨터 프로그래머 3급 (고급) (경연)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "국가 정보안전 수준 시험 2급 (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 개발자 인증 (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
