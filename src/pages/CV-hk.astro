---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import ProjectSection from "../components/ProjectSection.astro";
import { PROJECT_DATA } from "../data/projects";
import "../styles/global.css";
import "../styles/cv.css";

const projectData = PROJECT_DATA["zh-HK"];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-hk/#page",
  "url": "https://cv.wilboerht.com/CV-hk/",
  "inLanguage": "zh-HK",
  "name": "王泓坤 - 履歷",
  "description": "王泓坤的個人履歷頁面：常駐上海的數碼開發經理、全端工程師。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "數碼開發經理、全棧工程師（TypeScript / React / Next.js / AI / RAG），常駐上海。作為 Moidas（NIHPLOD）大中華區首位工程師，從零構建品牌官網、會員與積分體系、統一認證（SSO）、AI 護膚顧問、企微 AI 客服、授權驗真與雙小程式等數碼系統。",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科學技術職業學院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "SEO",
      "GEO (Generative Engine Optimization)",
      "AEO (Answer Engine Optimization)",
      "Docker",
      "Linux"
    ],
    "jobTitle": "數碼開發經理",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "穆埃達思 Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光計劃”職業院校技能競賽“網站技術”三等獎（上海市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“職業技能等級證書”電腦程式編寫員 三級（高級）（競賽）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "國家資訊安全水平考試二級（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級開發工程師認證（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里雲 ACA 雲安全助理工程師認證",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級運維工程師認證",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光計劃”職業院校技能競賽“網站技術”三等獎"
  }
};
---

<Layout title="王泓坤 - 履歷" lang="zh-HK">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">數碼開發經理 · 全棧工程師 · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>個人簡介</h2>
      <p class="entry-desc">
        常駐上海的數碼開發經理與全棧工程師，專注 TypeScript / React / Next.js 與 AI / RAG 工程化。作為 Moidas（NIHPLOD）大中華區首位工程師，從零構建品牌官網與會員平台、統一認證（SSO）、AI 護膚顧問、企業微信（企微）AI 客服、授權驗真平台、AI 測膚小程式與會員中心小程式等 7 個核心系統，配套 2,900+ 自動化測試用例；擅長以產品思維獨立完成從需求、設計到上線維運的端到端交付。
      </p>
    </section>

    <section>
      <h2>工作經歷</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">穆埃達思 Moidas · 旎柏（大中華區）事業部</h3>
          <div class="entry-meta">
            <span class="entry-role">數碼開發經理</span>
            <span class="entry-date">2025.10 – 至今</span>
          </div>
        </div>
        <p class="entry-summary">
          2025.10 以全職實習生加入，2026.07 轉正為數碼開發經理並直接匯報品牌負責人；作為事業部首位工程師，以產品思維與 AI 輔助研發獨立完成從需求、設計到開發、上線的全棧交付。入職 12 個月內從零構建並上線 7 個核心系統（其中 2 個小程式持續迭代），配套 2,900+ 自動化測試用例，並以統一帳戶與檔案數據形成「測膚 → 個人化方案 → 7×24 AI 顧問跟進 → 回購」業務閉環。
        </p>
        <ul class="project-points">
          <li>負責品牌大中華區數碼化產品矩陣的規劃、技術選型與全棧交付，統籌 7 個核心系統從需求、設計、開發到上線運維的完整生命週期。</li>
          <li>參與品牌大中華區會員體系制定，聯合品牌與營運團隊設計四檔會員等級、權益、積分與兌禮規則，並上線官網與小程式會員中心，支撐會員留存與回購。</li>
          <li>建立 AI 輔助研發工作流與設計規範，將平均交付週期縮短約 50%，支撐多專案並行交付。</li>
          <li>作為技術側負責人對接產品、營銷團隊需求並拆解排期，主導需求評審與迭代節奏，支撐品牌網上零售渠道（中國官網）從零上線。</li>
          <li>建立品牌官網與 AI 測膚站的搜尋與 AI 可發現性體系（SEO / GEO / AEO）：動態 sitemap、AI 爬蟲策略、Organization / Product / FAQ / HowTo JSON-LD、llms.txt / llms-full.txt、可後台維護的產品級 GEO FAQ，以及百度 / IndexNow 主動推送。</li>
          <li>主導 ICP 備案、私隱政策及用戶協議起草，完成數據合規審查，保障多系統合規上線。</li>
          <li>依據流量動態調整伺服器資源配置，優化伺服器成本。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.hk}
          alt="穆埃達思 Moidas 大中華區數碼化系統架構圖：統一認證（SSO）連接官網、AI 測膚、AI 客服與授權驗真等核心系統"
          zoomLabel="查看大圖"
          closeLabel="關閉"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海臨港景鴻安全防範科技發展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">技術研發實習生</span>
            <span class="entry-date">2025.07 – 2025.09</span>
          </div>
        </div>
        <ul class="project-points">
          <li>獨立承擔企業官網全鏈路交付，覆蓋從架構設計、UI/UX 設計到生產部署全過程。</li>
          <li>基於宇樹機器狗 SDK 二次開發，完成園區巡邏管理控制平台內部初版並驗證產品可行性。</li>
          <li>推動 AI 問答助手在企業內部首次上線，並參與公司與百度企業問答團隊的商務對接。</li>
        </ul>
      </div>
    </section>

    <ProjectSection locale="zh-HK" projects={projectData.projects} ui={projectData.ui} />

    <section>
      <h2>技術棧</h2>
      <div class="skills-row">
        <span class="skills-label">前端 &amp; 小程式：</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · 微信小程式 · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">後端 &amp; 數據：</span>
        <span class="skills-content">Node.js · Python (FastAPI) · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI 工程：</span>
        <span class="skills-content">大模型整合 · 視覺測膚 · RAG · 提示詞 / 知識庫 · AI 成本工程（熔斷 / 預算上限） · 模型評估與回歸測試 · AI 輔助研發（Claude Code / Codex）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">搜尋與 AI 可發現性：</span>
        <span class="skills-content">SEO · GEO · AEO · JSON-LD 結構化資料 · 動態 sitemap · AI 爬蟲策略 · llms.txt / llms-full.txt · 百度推送 / IndexNow</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">工程化 &amp; 平台：</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · 自動化測試（單元 / 整合 / 回歸）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合規：</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS（行級安全） · ICP 備案 · 私隱與數據合規（PIPL）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">產品 &amp; UI/UX：</span>
        <span class="skills-content">產品設計（PRD） · UI/UX 設計 · 互動設計 · 設計評審 · 設計到程式碼（design-to-code）</span>
      </div>
    </section>

    <section>
      <h2>獲獎及證書</h2>
      <div class="award-row">
        <span class="award-name">上海市「星光計劃」職業院校技能競賽 · 網站技術 三等獎（全市第 16 名）</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">人社部職業技能等級證書 · 電腦程式編寫員（三級/高級工，競賽）</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">國家資訊安全水平考試（NISP）二級</span>
        <span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">天翼雲高級運維工程師認證</span>
        <span class="award-date">2024.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">阿里雲 ACA 雲安全助理工程師</span>
        <span class="award-date">2024.10</span>
      </div>
      <div class="award-row">
        <span class="award-name">天翼雲高級開發工程師認證（SCCP）</span>
        <span class="award-date">2024.11</span>
      </div>
    </section>

    <section>
      <h2>教育背景</h2>
      <div class="entry education-entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <h3 class="entry-org">上海科學技術職業學院</h3>
          </div>
          <span class="entry-date">2023.10 – 2026.06</span>
        </div>
        <div class="entry-major">
          通訊與電子工程學院，資訊安全技術應用專業，專科
        </div>
        <p class="entry-desc">
          <strong>學業成績：</strong>GPA 3.41/4.00
        </p>
        <p class="entry-desc">
          <strong>校內獲獎：</strong>2023–2025 連續兩學年校二等獎學金，2023–2024 學年校優秀學生，校優秀畢業生
        </p>
        <p class="entry-desc">
          <strong>主修課程：</strong>網絡安全、程式設計、演算法與數據結構、計算機體系結構、作業系統、數據庫系統、電腦網絡等
        </p>
      </div>
    </section>

    <section>
      <h2>語言能力</h2>
      <div class="skills-row">
        <span class="skills-label">中文：</span>
        <span class="skills-content">母語</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">英文：</span>
        <span class="skills-content">大學英語四級（CET-4）</span>
      </div>
    </section>

    <section>
      <h2>其他</h2>
      <div class="award-row">
        <span class="award-name">Google Developer Group（GDG）社群成員</span>
      </div>
      <div class="award-row">
        <span class="award-name">中國電子學會青少年等級考試測評教師（Python）</span>
      </div>
    </section>
  </div>

  <PrintFooter
    warning="本履歷含個人私隱資訊，僅限招聘評估使用，未經授權禁止儲存、轉發或用於其他用途。"
  />
</Layout>
