---
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  lang: string;
  noindex?: boolean;
  description?: string;
  ogType?: string;
  alternates?: Record<string, string>;
  bodyClass?: string;
}

const {
  title,
  lang,
  noindex = false,
  description: descriptionOverride,
  ogType = "profile",
  alternates,
  bodyClass,
} = Astro.props;

const baseFontStylesheets = ["/fonts/source-serif-4.css"];
const cjkFontStylesheets = [
  ...(lang === "zh-CN" ? ["/fonts/noto-serif-sc.css"] : []),
  ...(lang === "zh-TW" || lang === "zh-HK" ? ["/fonts/noto-serif-tc.css"] : []),
  ...(lang === "ko" ? ["/fonts/noto-serif-kr.css"] : []),
  ...(lang === "ja" ? ["/fonts/noto-serif-jp.css"] : []),
];

const SITE_URL = Astro.site ? Astro.site.href.replace(/\/+$/, "") : "https://cv.wilboerht.com";

const desc: Record<string, string> = {
  "zh-CN": "王泓坤 - 简历",
  "zh-TW": "王泓坤 - 履歷",
  "zh-HK": "王泓坤 - 履歷",
  "en": "Hongkun Wang - CV",
  "de": "Hongkun Wang - Lebenslauf",
  "ko": "Hongkun Wang - 이력서",
  "ja": "王泓坤 - 履歴書",
};

const description = descriptionOverride ?? desc[lang] ?? desc["en"];

const langs = [
  { code: "zh-CN", label: "中", full: "中文", path: "/CV-cn/" },
  { code: "zh-TW", label: "繁", full: "繁體中文", path: "/CV-tw/" },
  { code: "zh-HK", label: "港", full: "繁體中文（香港）", path: "/CV-hk/" },
  { code: "en", label: "EN", full: "English", path: "/CV-en/" },
  { code: "de", label: "DE", full: "Deutsch", path: "/CV-de/" },
  { code: "ko", label: "한", full: "한국어", path: "/CV-kr/" },
  { code: "ja", label: "日", full: "日本語", path: "/CV-jp/" },
];
const currentLang = langs.find((l) => l.code === lang) ?? langs[0];

const saveLabels: Record<string, string> = {
  "zh-CN": "保存",
  "zh-TW": "儲存",
  "zh-HK": "儲存",
  en: "Save",
  de: "Speichern",
  ko: "저장",
  ja: "保存",
};

const ogLocales: Record<string, string> = {
  "zh-CN": "zh_CN",
  "zh-TW": "zh_TW",
  "zh-HK": "zh_HK",
  en: "en_US",
  de: "de_DE",
  ko: "ko_KR",
  ja: "ja_JP",
};

const ogLocale = ogLocales[lang] || ogLocales.en;

const ogImageAlt: Record<string, string> = {
  "zh-CN": "王泓坤 - 简历",
  "zh-TW": "王泓坤 - 履歷",
  "zh-HK": "王泓坤 - 履歷",
  en: "Hongkun Wang - CV",
  de: "Hongkun Wang - Lebenslauf",
  ko: "Hongkun Wang - 이력서",
  ja: "王泓坤 - 履歴書",
};

const skipLabels: Record<string, string> = {
  ja: "本文へスキップ",
  "zh-CN": "跳到正文",
  "zh-TW": "跳至正文",
  "zh-HK": "跳至正文",
  en: "Skip to content",
  de: "Zum Inhalt springen",
  ko: "본문으로 건너뛰기",
};

const navLabels: Record<string, string> = {
  "zh-CN": "语言 / 保存简历",
  "zh-TW": "語言 / 儲存履歷",
  "zh-HK": "語言 / 儲存履歷",
  en: "Language / Save CV",
  de: "Sprache / Lebenslauf speichern",
  ko: "언어 / 이력서 저장",
  ja: "言語 / 履歴書を保存",
};

const languageLabels: Record<string, string> = {
  "zh-CN": "语言",
  "zh-TW": "語言",
  "zh-HK": "語言",
  en: "Language",
  de: "Sprache",
  ko: "언어",
  ja: "言語",
};

const homeLabels: Record<string, string> = {
  "zh-CN": "首页",
  "zh-TW": "首頁",
  "zh-HK": "首頁",
  en: "Home",
  de: "Startseite",
  ko: "홈",
  ja: "ホーム",
};

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = `${SITE_URL}${pathname}`;

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "url": `${SITE_URL}/CV-en/`,
  "name": "Hongkun Wang · CV",
  "inLanguage": langs.map((l) => l.code),
  "publisher": { "@id": "https://wilboerht.com/#person" },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": homeLabels[lang] || homeLabels.en,
      "item": `${SITE_URL}/CV-en/`,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": canonical,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content="Hongkun Wang" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <meta property="og:site_name" content="Hongkun Wang · CV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="profile:first_name" content="Hongkun" />
    <meta property="profile:last_name" content="Wang" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt[lang] || ogImageAlt.en} />
    <meta property="og:locale" content={ogLocale} />
    {
      langs
        .filter((l) => l.code !== lang)
        .map((l) => (
          <meta property="og:locale:alternate" content={ogLocales[l.code]} />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:alt" content={ogImageAlt[lang] || ogImageAlt.en} />

    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex && langs.map((l) => (
        <link
          rel="alternate"
          hreflang={l.code}
          href={`${SITE_URL}${alternates?.[l.code] ?? l.path}`}
        />
      ))
    }
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alternates?.en ?? "/CV-en/"}`} />
    )}

    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {baseFontStylesheets.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {cjkFontStylesheets.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}

    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd, null, 2)} />}
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd, null, 2)} />}

    <noscript>
      <style>
        .project-extra[hidden] { display: block !important; }
        .project-toggle-wrap { display: none; }
        section:has(> .project-extra[hidden]) > .project-entry:has(+ .project-extra[hidden]) { margin-bottom: 24px; }
      </style>
    </noscript>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{skipLabels[lang] || skipLabels.en}</a>

    <nav class="cv-toolbar" aria-label={navLabels[lang] || navLabels.en}>
      <div class="cv-lang">
        <span class="cv-lang-label" aria-hidden="true">{currentLang.label}</span>
        <select
          id="cv-lang"
          class="cv-lang-select"
          aria-label={languageLabels[lang] || languageLabels.en}
          onchange="location.href=this.value"
        >
          {
            langs.map((l) => (
              <option value={alternates?.[l.code] ?? l.path} selected={l.code === lang}>
                {l.full}
              </option>
            ))
          }
        </select>
      </div>
      <noscript>
        <span class="cv-lang-fallback">
          {langs.map((l) => (
            <a href={alternates?.[l.code] ?? l.path} hreflang={l.code} lang={l.code}>{l.full}</a>
          ))}
        </span>
      </noscript>
      <span class="cv-toolbar-divider" aria-hidden="true"></span>
      <a class="cv-toolbar-save" href="/wanghongkun-cv.pdf" download="王泓坤 CV.pdf">
        {saveLabels[lang] || saveLabels.en}
      </a>
    </nav>

    <svg style="display:none" aria-hidden="true">
      <symbol id="icon-phone" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="icon-mail" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22,6 12,13 2,6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="icon-github" viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="icon-twitter" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="icon-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m21 15-5-5L5 21" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="icon-file-text" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><line x1="8" y1="13" x2="16" y2="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8" y1="17" x2="14" y2="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
      <symbol id="icon-external" viewBox="0 0 24 24"><path d="M14 3h7v7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 14 21 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </svg>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} alternates={alternates} />

    <script>
      document.querySelectorAll("[data-project-toggle]").forEach((button) => {
        const targetId = button.getAttribute("aria-controls");
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        button.addEventListener("click", () => {
          const expanded = button.getAttribute("aria-expanded") === "true";
          button.setAttribute("aria-expanded", String(!expanded));
          target.hidden = expanded;
        });
      });
    </script>
  </body>
</html>
